# Local development defaults. Copy this file to .env; never commit that local file.
# Values below are safe defaults or placeholders, not deployment credentials.
ENVIRONMENT=development
PUBLIC_DEMO_MODE=false
NETWORK_NAME=zoidberg-testnet
NODE_ID=node-a
NODE_HOST=127.0.0.1
NODE_PORT=8000
PUBLIC_NODE_URL=http://127.0.0.1:8000
API_BASE_URL=http://127.0.0.1:8000
FRONTEND_ORIGIN=http://127.0.0.1:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://zoidbergcoin.com,https://www.zoidbergcoin.com
NODE_DATA_DIR=data/node-a
DATA_DIR=data/node-a
LOG_DIR=data/node-a/logs
LOG_LEVEL=INFO

STORAGE_BACKEND=json
# SQLITE_DB_PATH=data/node-a/zoidbergchain.db
CONTENT_STORAGE_DIR=data/node-a/content

# Testnet/production peer authentication requires a unique secret from a secret manager.
# Replace the placeholder before running a public node; do not put wallet keys here.
PEER_SHARED_SECRET=replace-with-long-random-secret
ENABLE_SIGNED_PEER_MESSAGES=true
PEER_SIGNATURE_WINDOW_SECONDS=300
PEER_REPLAY_PROTECTION_ENABLED=true
REQUIRE_PEER_AUTH=false

# Development mode enables local-only tools for wallet export, reset, and debugging.
# Never deploy a public server with ENVIRONMENT=development.
# Never deploy a public server with PUBLIC_API_MODE=false.
# Testnet and production defaults block dev tools and private key export.
ALLOW_DEV_WALLET_PRIVATE_KEY_EXPORT=true
ALLOW_DEV_RESET_ENDPOINTS=true
ALLOW_INSECURE_LOCAL_PEERS=true
PUBLIC_API_MODE=false

# Rate limiting is usually disabled in local development so repeated manual testing stays smooth.
# Testnet and production should use RATE_LIMITING_ENABLED=true or ENABLE_RATE_LIMITING=true.
RATE_LIMITING_ENABLED=false
RATE_LIMIT_TRANSACTION_CREATE=30/minute
RATE_LIMIT_WALLET_CREATE=30/minute
RATE_LIMIT_SUBMISSION_CREATE=20/minute
RATE_LIMIT_VOTE=60/minute
RATE_LIMIT_EVALUATE=20/minute
RATE_LIMIT_MINT=20/minute
RATE_LIMIT_CHAIN_SYNC=30/minute
RATE_LIMIT_PEER_RECEIVE=120/minute
RATE_LIMIT_PUBLIC_READ=120/minute
RATE_LIMIT_DEV_ENDPOINTS=30/minute
RATE_LIMIT_ADMIN_LOGIN=20/minute

# Request and upload limits.
MAX_CONTENT_FILE_SIZE_BYTES=5242880
MAX_TEXT_CONTENT_BYTES=262144
MAX_CAPTION_LENGTH=1000
MAX_FILENAME_LENGTH=255
ENABLE_STRICT_MIME_VALIDATION=true

# Frontend build-time settings for zoidbergcoin-ui.
VITE_API_BASE_URL=http://127.0.0.1:8000
VITE_ENVIRONMENT=development
VITE_PUBLIC_DEMO_MODE=false
VITE_ENABLE_DEV_TOOLS=true

# Reviewer eligibility / anti-Sybil friction defaults.
# Development stays open by default.
# Testnet and production should usually use allowlist or hybrid mode.
REVIEW_ELIGIBILITY_MODE=open
REVIEW_ALLOWLIST_WALLETS=
REVIEW_DENYLIST_WALLETS=
MIN_REVIEWER_ACCOUNT_AGE_SECONDS=0
MIN_REVIEWER_SUBMISSION_COUNT=0
MIN_REVIEWER_VOTE_COUNT=0
MIN_REVIEWER_REWARD_COUNT=0
MIN_REVIEWER_SETTLED_BALANCE_ZOID=0
MIN_REVIEWER_SETTLED_TRANSFER_COUNT=0
MAX_REVIEW_VOTES_PER_WALLET_PER_DAY=0
REVIEW_POLICY_PUBLIC_LABEL=Open local review voting

# Voter majority rewards.
# Development may enable a small pool for local testing.
# Testnet and production should keep this disabled unless operators explicitly want it.
VOTER_REWARDS_ENABLED=false
VOTER_REWARD_POOL_PER_DECISION_ZOID=1
VOTER_REWARD_MAX_PER_WALLET_ZOID=0
VOTER_REWARD_MIN_DECISIVE_VOTES=1
VOTER_REWARD_REQUIRE_REVIEW_ELIGIBLE=true
VOTER_REWARD_APPROVAL_SIDE=original
VOTER_REWARD_REJECTION_SIDE=not_original

# Public Testnet v1 validator-quorum finality. Validators are Ethereum/MetaMask
# addresses, not peer node identities. Leave empty for local development: an
# empty validator set never finalizes a block.
PUBLIC_TESTNET_V1_VALIDATOR_ADDRESSES=

# Controlled access gate / wallet binding.
# Development stays open by default and can still bypass access checks locally.
ACCESS_CONTROL_MODE=open
ACCESS_REQUESTS_ENABLED=true
ACCESS_DEV_BYPASS_ENABLED=true
REQUIRE_ACCESS_FOR_APP=false
REQUIRE_ACCESS_FOR_SUBMISSIONS=false
REQUIRE_ACCESS_FOR_VOTES=false
REQUIRE_ACCESS_FOR_REWARDS=false
REQUIRE_ACCESS_FOR_TRANSFERS=false
MAX_WALLETS_PER_ACCESS_ACCOUNT=1
ACCESS_PUBLIC_LABEL=Open local development

# Admin UI / operator access dashboard.
# Keep credentials server-side only. Never place them in frontend env files or this template.
ADMIN_UI_ENABLED=true
ADMIN_AUTH_ENABLED=true
ADMIN_SESSION_TTL_SECONDS=3600
# Generate with: python -m scripts.access_admin generate-admin-password-hash
ADMIN_PASSWORD_HASH=
# Optional early-testing fallback. Prefer ADMIN_PASSWORD_HASH instead.
ADMIN_BOOTSTRAP_TOKEN=

# Public demo / controlled testnet example values for zoidbergcoin.com:
#
# ENVIRONMENT=testnet
# PUBLIC_DEMO_MODE=true
# NETWORK_NAME=zoidberg-public-demo-1
# NODE_ID=zoidberg-public-demo-node-1
# NODE_HOST=127.0.0.1
# NODE_PORT=8000
# PUBLIC_NODE_URL=https://zoidbergcoin.com
# API_BASE_URL=https://zoidbergcoin.com/api
# FRONTEND_ORIGIN=https://zoidbergcoin.com
# CORS_ALLOWED_ORIGINS=https://zoidbergcoin.com,https://www.zoidbergcoin.com
# STORAGE_BACKEND=sqlite
# DATA_DIR=/var/lib/zoidbergchain
# SQLITE_DB_PATH=/var/lib/zoidbergchain/zoidbergchain.sqlite3
# CONTENT_STORAGE_DIR=/var/lib/zoidbergchain/content
# PEER_SHARED_SECRET=replace-with-real-secret
# REQUIRE_PEER_AUTH=true
# ENABLE_SIGNED_PEER_MESSAGES=true
# RATE_LIMITING_ENABLED=true
# MAX_CONTENT_FILE_SIZE_BYTES=5242880
# MAX_TEXT_CONTENT_BYTES=100000
# LOG_LEVEL=INFO
# REVIEW_ELIGIBILITY_MODE=allowlist
# REVIEW_ALLOWLIST_WALLETS=0xabc...,0xdef...
# REVIEW_DENYLIST_WALLETS=0xdead...
# MAX_REVIEW_VOTES_PER_WALLET_PER_DAY=10
# REVIEW_POLICY_PUBLIC_LABEL=Invite-only testnet reviewer policy
# ACCESS_CONTROL_MODE=invite_only
# ACCESS_REQUESTS_ENABLED=true
# ACCESS_DEV_BYPASS_ENABLED=false
# REQUIRE_ACCESS_FOR_APP=true
# REQUIRE_ACCESS_FOR_SUBMISSIONS=true
# REQUIRE_ACCESS_FOR_VOTES=true
# REQUIRE_ACCESS_FOR_REWARDS=true
# REQUIRE_ACCESS_FOR_TRANSFERS=true
# MAX_WALLETS_PER_ACCESS_ACCOUNT=1
# ACCESS_PUBLIC_LABEL=Controlled invite-only testnet
# ADMIN_UI_ENABLED=true
# ADMIN_AUTH_ENABLED=true
# ADMIN_SESSION_TTL_SECONDS=3600
# ADMIN_PASSWORD_HASH=pbkdf2_sha256$...
# RATE_LIMIT_ADMIN_LOGIN=5/minute
# VOTER_REWARDS_ENABLED=false
# VOTER_REWARD_POOL_PER_DECISION_ZOID=1
# VOTER_REWARD_MAX_PER_WALLET_ZOID=0
# VOTER_REWARD_MIN_DECISIVE_VOTES=1
# VOTER_REWARD_REQUIRE_REVIEW_ELIGIBLE=true
# VOTER_REWARD_APPROVAL_SIDE=original
# VOTER_REWARD_REJECTION_SIDE=not_original

# To intentionally test invite-only access locally:
# ENVIRONMENT=development
# ACCESS_CONTROL_MODE=invite_only
# ACCESS_DEV_BYPASS_ENABLED=false
# REQUIRE_ACCESS_FOR_APP=true
# REQUIRE_ACCESS_FOR_SUBMISSIONS=true
# REQUIRE_ACCESS_FOR_VOTES=true
# REQUIRE_ACCESS_FOR_REWARDS=true
# REQUIRE_ACCESS_FOR_TRANSFERS=true
